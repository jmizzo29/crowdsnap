# Public name on the Buy button. Paste a Stripe Payment Link,
# Lemon Squeezy, or Polar URL. One-time purchase only.
VITE_PAYMENT_LINK=https://buy.stripe.com/placeholder

# Shared wall across phones (already used by the live Grouppix deploy).
# Create a Supabase project, run supabase/schema.sql, then paste these.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_SUPABASE_BUCKET=trip-media

# Optional: Vercel Blob so two phones share a wall without Supabase.
# Set on Vercel (server only). Do not prefix with VITE_.
# BLOB_READ_WRITE_TOKEN=

# Optional: keep group listing off the anon key by talking to Supabase
# only from /api with the service role (server only).
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
