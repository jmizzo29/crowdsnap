# Polar checkout is hardcoded in src/lib/config.js ($49 once per event).
# Success URL in Polar: https://grouppix.vercel.app/new

# Production reads VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY from
# .env.production (public anon key for crowdsnap_dev). Do not invent keys.
# Local override: copy this file to .env.local.
# VITE_SUPABASE_URL=https://cxvpozabohbieaplsvjw.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_BUCKET=trip-media

# Optional: Vercel Blob so two phones share a wall without Supabase.
# Set on Vercel (server only). Do not prefix with VITE_.
# BLOB_READ_WRITE_TOKEN=

# Optional: keep group listing off the anon key by talking to Supabase
# only from /api with the service role (server only).
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
